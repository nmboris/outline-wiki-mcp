# Outline Wiki Configuration
# For stdio mode: These are required
# For HTTP mode: Only OUTLINE_BASE_URL is required (users provide their own API keys)
OUTLINE_BASE_URL=https://your-instance.getoutline.com
OUTLINE_API_KEY=ol_api_xxx

# MCP Transport Configuration
# Transport mode: 'stdio' (default) or 'http'/'sse'
MCP_TRANSPORT=stdio

# HTTP Transport Settings (only for HTTP mode)
MCP_PORT=3000
MCP_PATH=/mcp

# Multi-Tenant Mode (HTTP):
# Users authenticate with their Outline API key as Bearer token
# Example: Authorization: Bearer ol_api_user_token

# Optional: Additional MCP Access Control (HTTP only)
# When enabled, requires both MCP_BEARER_TOKEN + user's Outline token
# MCP_REQUIRE_AUTH=true
# MCP_BEARER_TOKEN=your-mcp-access-token
